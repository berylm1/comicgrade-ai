# ComicGrade AI — React Native client environment
# Copy to .env (Expo inlines EXPO_PUBLIC_* vars at bundle time).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# On an iOS simulator this works; on a real device use your Mac's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Demo mode: run the whole app on built-in sample data (no backend/Supabase/camera).
# On automatically when EXPO_PUBLIC_API_BASE_URL is unset; 1 forces it on, 0 off.
# EXPO_PUBLIC_DEMO_MODE=1
