# ComicGrade AI — Backend configuration
# Copy to `.env` and fill in your own credentials. NEVER commit the real file.

# ---- Supabase ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Valuation sources ----
GOCOLLECT_API_KEY=your-gocollect-api-key

# ---- AI Vision ----
# Provider of the vision endpoint. Supported: "mock" | "openai"
VISION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Storage bucket created by migration 002
STORAGE_BUCKET=cover-images