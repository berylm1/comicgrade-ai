# ComicGrade AI — Backend configuration
# Copy to `.env` and fill in your own credentials. NEVER commit the real file.

# ---- Supabase ----
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (sb_publishable_...) or legacy anon key. Optional for the backend.
SUPABASE_ANON_KEY=your-anon-key
# Secret (sb_secret_...) or legacy service_role key. Server only: never ship it in the app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Auth ----
# true: every request needs a Supabase access token (Authorization: Bearer <token>).
# false: requests without a token act as DEV_USER_ID. Local testing only; never in production.
AUTH_REQUIRED=false
# A user id from Supabase > Authentication > Users (used when AUTH_REQUIRED=false).
DEV_USER_ID=
# Shared secret for the nightly POST /portfolio/snapshot/all job (send it as X-Cron-Secret).
CRON_SECRET=

# ---- Valuation sources ----
GOCOLLECT_API_KEY=your-gocollect-api-key

# ---- AI Vision ----
# Provider of the vision endpoints. Supported: "mock" | "openai" | "claude"
# Only "claude" reads all three scan photos (front, back, spine) and scores each area.
VISION_PROVIDER=mock
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Higher is slower and costs more per scan.
CLAUDE_EFFORT=medium
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Storage bucket created by migration 002
STORAGE_BUCKET=cover-images